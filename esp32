const int SENSOR_RPM = 34;

const float CIRCUNFERENCIA = 1.755; // metros

const int METAIS_POR_VOLTA = 2;

volatile unsigned long ultimoPulso = 0;
volatile unsigned long intervaloPulso = 0;
volatile unsigned long pulsos = 0;

float rpm = 0;
float velocidade = 0;

unsigned long ultimoPrint = 0;


// Interrupção
void IRAM_ATTR detectarPulso() {

    unsigned long agora = micros();

    if (ultimoPulso > 0) {
        intervaloPulso = agora - ultimoPulso;
    }

    ultimoPulso = agora;

    pulsos++;
}


void setup() {

    Serial.begin(115200);

    pinMode(SENSOR_RPM, INPUT);

    attachInterrupt(
        digitalPinToInterrupt(SENSOR_RPM),
        detectarPulso,
        FALLING
    );
}


void loop() {

    unsigned long intervaloAtual;
    unsigned long ultimoPulsoAtual;
    unsigned long pulsosAtual;

    // Copia os valores de forma segura
    noInterrupts();

    intervaloAtual = intervaloPulso;
    ultimoPulsoAtual = ultimoPulso;
    pulsosAtual = pulsos;

    interrupts();


    // Calcula RPM
    if (intervaloAtual > 0) {

        rpm = 60000000.0 /
              (intervaloAtual * METAIS_POR_VOLTA);
    }


    // Se não houver pulso durante 2 segundos,
    // considera a roda parada
    if (ultimoPulsoAtual != 0 &&
        micros() - ultimoPulsoAtual > 2000000) {

        rpm = 0;
    }


    // Calcula velocidade
    velocidade =
        (CIRCUNFERENCIA * rpm / 60.0) * 3.6;


    // Mostra os dados a cada 500 ms
    if (millis() - ultimoPrint >= 500) {

        Serial.print("Pulsos = ");
        Serial.print(pulsosAtual);

        Serial.print(" | RPM = ");
        Serial.print(rpm);

        Serial.print(" | Velocidade = ");
        Serial.print(velocidade);

        Serial.println(" km/h");

        ultimoPrint = millis();
    }
}