#include <Wire.h>
  const int SENSOR_RPM = 34;
  int estadoAnterior = LOW;

  volatile unsigned long ultimaVolta = 0;
  float rpm = 0;
  int voltas = 0;

void setup() {
  
  pinMode(SENSOR_RPM, INPUT);
  Serial.begin(115200);

}

void loop() {
  
  int estadoAtual = digitalRead(SENSOR_RPM);

  if(estadoAtual == HIGH && estadoAnterior == LOW){
    
    voltas++;

    unsigned long agora = millis();

    if(ultimaVolta > 0){
      unsigned long intervalo = agora - ultimaVolta;

      rpm = 60000.0/intervalo; 
    }


    ultimaVolta = agora;

    if (millis() - ultimaVolta > 2000) {
    rpm = 0;
    }

   Serial.print("RPM = ");
    Serial.println(rpm); 


  }

  estadoAnterior = estadoAtual;

  delay(1000);

  
}
